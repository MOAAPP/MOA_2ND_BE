# 평행통장 V4.0: VS Code / Finder에서 이 내용을 .env로 복사하고 키를 직접 입력하세요.
# 실제 .env 파일은 Git에 올리지 않습니다. 터미널 export/source 불필요.
# ChatGPT 구독 키와 별도로 API 제공업체에서 발급한 키를 사용하세요.

# 공통 OpenAI 호환 LLM: 다른 제공업체도 base_url/model을 바꾸면 연결 가능
MOA_AI_API_KEY=
MOA_AI_BASE_URL=https://api.openai.com/v1
MOA_AI_MODEL=gpt-4.1-mini

# 금융 AI 에이전트 (비워두면 공통 MOA_AI_* 사용)
MOA_AGENT_API_KEY=
MOA_AGENT_BASE_URL=
MOA_AGENT_MODEL=
MOA_AGENT_TIMEOUT_SECONDS=20

# 쇼핑 스크린샷 분석용 비전 API (비워두면 공통 MOA_AI_* 사용)
# 이미지 지원 Chat Completions 호환 모델/엔드포인트만 지정
MOA_VISION_API_KEY=
MOA_VISION_BASE_URL=
MOA_VISION_MODEL=

# 개인화 설명 및 금융 학습 퀴즈 생성 (값을 입력하지 않으면 공통 모델 사용)
MOA_BRIEFING_MODEL=
MOA_QUIZ_MODEL=

# 구버전 설정 호환: 기존 키를 별도로 쓰는 경우
OPENAI_API_KEY=
OPENAI_VISION_MODEL=
OPENAI_TEXT_MODEL=

# API 테스트·금융 엔진은 키 없이도 동작합니다
MOA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MOA_AGENT_INPUT_USD_PER_M=0
MOA_AGENT_OUTPUT_USD_PER_M=0
# MOA_RUNTIME_DIR=app/data/runtime
# MOA_DATASET_PATH=app/data/source/moa_20users_financial_test_JSON.zip
