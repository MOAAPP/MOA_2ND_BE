# Stage 2 local FastAPI only. Do not commit this file with real values.
# Python reads exported shell variables, NOT .env automatically.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_TEXT_MODEL=gpt-4o-mini

# Original versioned 20-user synthetic dataset is read-only
# MOA_DATASET_PATH=/absolute/path/to/moa_20users_financial_test_JSON.zip
# Local overlay is per user and ignored by Git
# MOA_RUNTIME_DIR=/absolute/path/to/runtime

MOA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Stage 5: server-side only (never use VITE_)
MOA_AGENT_API_KEY=
MOA_AGENT_MODEL=gpt-4.1-mini
# Optional OpenAI-compatible gateway URL
MOA_AGENT_BASE_URL=
MOA_AGENT_TIMEOUT_SECONDS=12
# Actual provider pricing per 1 million input/output tokens, USD. 0 = cost unknown
MOA_AGENT_INPUT_USD_PER_M=0
MOA_AGENT_OUTPUT_USD_PER_M=0
